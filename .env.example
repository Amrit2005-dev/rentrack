# TMS Backend — .env.example
# Module: Bootstrap | Path: .env.example
# Copy to .env and fill in real values before running

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://tms:tms@localhost:5432/tms

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT / Auth ───────────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_256_bit_random_secret_key_do_not_use_this_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── OTP Settings ─────────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_COUNT=3
OTP_RATE_LIMIT_WINDOW_MINUTES=10
OTP_LOCKOUT_MINUTES=30
# Set true only for local testing; never expose OTPs in shared environments.
SHOW_TEST_OTP=false

# ─── SMS Provider ─────────────────────────────────────────────────────────────
SMS_PROVIDER=twilio           # or msg91
SMS_API_KEY=your_twilio_auth_token
SMS_API_SECRET=your_twilio_account_sid   # used by Twilio only
SMS_FROM_NUMBER=+1234567890

# ─── Object Storage (S3-compatible) ───────────────────────────────────────────
STORAGE_BUCKET=tms-files
STORAGE_ENDPOINT=https://s3.amazonaws.com
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
STORAGE_REGION=ap-south-1
# s3, or local to keep uploads in ./uploads (development without S3)
STORAGE_BACKEND=local
PUBLIC_BASE_URL=http://localhost:8000

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,http://localhost:19006

# ─── Email (for quotation sharing) ────────────────────────────────────────────
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# ─── Resend (Transactional Email / 2FA) ───────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@renttrack.com
