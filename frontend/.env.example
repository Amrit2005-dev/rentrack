# Local development only. EAS builds do not read this file — it is gitignored —
# so every build profile carries its own values in eas.json.

# Opt-in, and only ever "true". Anything else (including absent) means the app
# talks to EXPO_PUBLIC_API_URL over the real network. It defaults to off so a
# build that forgets to set it cannot ship fake data.
#
# With it on, an in-memory backend (src/api/mock) answers every request: sign
# in with 9000000002 (admin), 9000000001 (super admin), 9000000008 (manager),
# 9000000003 (driver); the OTP is always 123456.
EXPO_PUBLIC_USE_MOCK_API=false

# Must include the /api/v1 prefix. Baked in at build time, so a device build
# needs a host the device can actually reach — localhost is meaningless there.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Google sign-in. The button stays hidden unless the id for the current
# platform is set, and the exchange needs a POST /auth/google the API does not
# have yet — leave these empty until it does.
# EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
# EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
# EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
